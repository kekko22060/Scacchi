<Window x:Class="progettoIndividualeInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:progettoIndividualeInfo"
        mc:Ignorable="d"
        Title="Scacchiera" Height="500" Width="500">

    <Grid Background="#FFD0D0D0">
        <!-- Definizione delle 8 Righe -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Definizione delle 8 Colonne -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Riga 0 -->
        <Border Grid.Row="0" Grid.Column="0" Background="White"/>
        <Border Grid.Row="0" Grid.Column="1" Background="#769656"/>
        <Border Grid.Row="0" Grid.Column="2" Background="White"/>
        <Border Grid.Row="0" Grid.Column="3" Background="#769656"/>
        <Border Grid.Row="0" Grid.Column="4" Background="White"/>
        <Border Grid.Row="0" Grid.Column="5" Background="#769656"/>
        <Border Grid.Row="0" Grid.Column="6" Background="White"/>
        <Border Grid.Row="0" Grid.Column="7" Background="#769656"/>

        <!-- Riga 1 -->
        <Border Grid.Row="1" Grid.Column="0" Background="#769656"/>
        <Border Grid.Row="1" Grid.Column="1" Background="White"/>
        <Border Grid.Row="1" Grid.Column="2" Background="#769656"/>
